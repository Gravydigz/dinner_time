#!/bin/bash
# .githooks/pre-commit — wrapper; the real hook lives in the secrets-process repo
# (github.com/Gravydigz/secrets-process). Don't edit this file: fix the hook there.
# Fails closed: without the central hooks, no commit.
H="${SECRETS_PROCESS_DIR:-$HOME/.secrets-process}/hooks/pre-commit"
[ -x "$H" ] || { echo "pre-commit: secrets-process hooks not found at $H — commit blocked (clone github.com/Gravydigz/secrets-process there, or set SECRETS_PROCESS_DIR)" >&2; exit 1; }
exec "$H" "$@"
